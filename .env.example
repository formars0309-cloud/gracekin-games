# 기본값은 로컬 컴퓨터에서만 접속할 수 있습니다.
HOST=127.0.0.1
PORT=8766
DATA_DIR=.data

# 공개 운영 환경에서만 설정: HTTPS 주소와 별도로 발급한 32자 이상 비밀키가 필수입니다.
# NODE_ENV=production
# BETTER_AUTH_URL=https://실제-운영-주소
# BETTER_AUTH_SECRET=

# 메일 설정이 없으면 기존 로그인은 유지하고 새 가입·인증메일·비밀번호 복구는 준비 중으로 표시합니다.
# Resend 발신 도메인은 인증 완료. 아래 값은 연결 예시이며 자동으로 활성화되지 않습니다.
# 실제 발송·회신 수신 시험과 공개 방침 반영을 마친 뒤 운영 secret에 설정합니다.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS에는 사용자가 발급한 도메인 제한 발송용 API 키를 비공개로 설정합니다.
# 키는 이 파일·명령 인자·로그·저장소에 기록하지 않습니다.
# SMTP_PASS=
# SMTP_FROM=그레이스킨게임즈 <account@mail.gracekingames.com>
# 465는 TLS, 587은 필수 STARTTLS를 사용합니다. 평문 SMTP는 지원하지 않습니다.

# 보호자 회신 자동 확인: 실제 수신·서명 검증·승인/보류 시험 전에는 켜지 않습니다.
# 아래는 설명용 설정이며 실제 수신 주소·키를 이 파일에 저장하지 않습니다.
# GUARDIAN_CONSENT_MODE=email-reply-auto
# GUARDIAN_REPLY_TO=guardian@YOUR-TEAM.resend.app
# RESEND_RECEIVING_API_KEY=
# RESEND_WEBHOOK_SECRET=
# GUARDIAN_AUTO_APPROVAL_READY=false
# 수신용 Full access 키와 webhook 서명키는 사용자가 발급합니다. 기존 SMTP 발송 전용 키는 유지합니다.
# Resend의 email.received webhook 경로: /api/webhooks/resend/guardian
# 위 준비를 실제로 검증한 뒤에만 GUARDIAN_AUTO_APPROVAL_READY=true로 설정합니다.
# 기존 운영자 검토 방식이 필요하면 GUARDIAN_CONSENT_MODE=email-reply-review로 구분합니다.
