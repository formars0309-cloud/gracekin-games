# 기본값은 로컬 컴퓨터에서만 접속할 수 있습니다.
HOST=127.0.0.1
PORT=8766
DATA_DIR=.data

# 공개 운영 환경에서만 설정: HTTPS 주소와 별도로 발급한 32자 이상 비밀키가 필수입니다.
# NODE_ENV=production
# BETTER_AUTH_URL=https://실제-운영-주소
# BETTER_AUTH_SECRET=

# 메일 설정이 없으면 기존 로그인은 유지하고 새 가입·인증메일·비밀번호 복구는 준비 중으로 표시합니다.
# 실제 설정은 운영 메일 서비스의 발신 도메인 인증·수신 회신함 준비 후 입력합니다.
# SMTP_HOST=smtp.example.test
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=account@example.test
# 보호자 동의 회신을 실제로 받고 운영자가 검토할 수 있는 주소
# GUARDIAN_REPLY_TO=support@example.test
# 465는 TLS, 587은 필수 STARTTLS를 사용합니다. 평문 SMTP는 지원하지 않습니다.
