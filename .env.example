# 기본값은 로컬 컴퓨터에서만 접속할 수 있습니다.
HOST=127.0.0.1
PORT=8766
DATA_DIR=.data

# 공개 운영 환경에서만 설정: HTTPS 주소와 별도로 발급한 32자 이상 비밀키가 필수입니다.
# NODE_ENV=production
# BETTER_AUTH_URL=https://실제-운영-주소
# BETTER_AUTH_SECRET=

# 메일 설정이 없으면 기존 로그인은 유지하고 새 가입·인증메일·비밀번호 복구는 준비 중으로 표시합니다.
# Resend 발신 도메인은 인증 완료. 아래 값은 연결 예시이며 자동으로 활성화되지 않습니다.
# 실제 발송·회신 수신 시험과 공개 방침 반영을 마친 뒤 운영 secret에 설정합니다.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS에는 사용자가 발급한 도메인 제한 발송용 API 키를 비공개로 설정합니다.
# 키는 이 파일·명령 인자·로그·저장소에 기록하지 않습니다.
# SMTP_PASS=
# SMTP_FROM=그레이스킨게임즈 <account@mail.gracekingames.com>
# 보호자 동의 회신의 최종 수신함·검토 담당자까지 확인한 뒤 별도로 설정합니다.
# GUARDIAN_REPLY_TO=support@gracekingames.com
# 465는 TLS, 587은 필수 STARTTLS를 사용합니다. 평문 SMTP는 지원하지 않습니다.
